# Environment Variables — TEMPLATE
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to Git.

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas (cloud):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow
# MongoDB local (Docker):  mongodb://mongodb:27017/taskflow
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow

# ─── Redis ────────────────────────────────────────────────────────────────────
# When running inside Docker Compose: redis://redis:6379
# When running locally outside Docker: redis://localhost:6379
REDIS_URL=redis://redis:6379

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=3000
